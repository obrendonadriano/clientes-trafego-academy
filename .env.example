NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=dashboard.trafegoacademy.online
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Chave da rota POST /api/sync-meta (header x-sync-key). Use um valor aleatorio longo.
SYNC_SECRET_KEY=

# Atendimento por IA no WhatsApp (opcional: o admin tambem salva em
# Configuracoes -> DeepSeek, e o valor do banco tem prioridade).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Conversões: WhatsApp Business oficial (Coexistence) + Conversions API ---
# App da Meta usado no Embedded Signup e na validação do webhook. Se ficarem
# vazios, o app_id/app_secret salvos em Admin -> Configurações -> Meta Ads são
# usados como reserva. O App Secret NUNCA vai para o navegador.
META_APP_ID=
META_APP_SECRET=
# Configuration ID do Embedded Signup (Meta App -> WhatsApp -> Embedded Signup).
# Precisa estar configurado para WhatsApp Business App Onboarding (Coexistence).
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Token que a Meta envia em hub.verify_token ao cadastrar a URL do webhook.
# Use um valor aleatorio longo; o mesmo valor vai no painel da Meta.
META_WEBHOOK_VERIFY_TOKEN=
# Chave AES-256 que cifra os tokens dos clientes no banco: openssl rand -base64 32
META_CREDENTIALS_KEY=
# Versao da Graph API. Vazio usa a estavel embutida no codigo (v26.0).
META_GRAPH_VERSION=
# Conta de anuncios da Tráfego Academy (act_...). Apenas diagnostico: a
# atribuicao da Meta e pelo Dataset do cliente, nao pela conta.
META_AD_ACCOUNT_ID=
# Liga o envio de conversoes para a Meta. Fica desligado ate a validacao em
# staging terminar; com ele desligado a fila acumula sem enviar nada.
CONVERSIONS_DISPATCHER_ENABLED=false
