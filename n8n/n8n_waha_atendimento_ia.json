    {
      "parameters": {
        "jsCode": "// Minimal transport; the dashboard validates, routes and decides.\nconst root = $json.body ?? $json;\nconst p = root.payload ?? root;\nconst d = p._data ?? {};\nconst fromMe = p.fromMe === true || d.fromMe === true;\nconst id = p.id ?? root.messageId;\nconst mime = p.media?.mimetype ?? '';\nconst type = p.type ?? d.type;\nreturn [{ json: {\n  session: root.session ?? root.sessionName,\n  event: root.event ?? 'message.any',\n  chatId: root.chatId ?? (fromMe ? p.to : p.from),\n  messageId: typeof id === 'string' ? id : (id?._serialized ?? id?.id),\n  fromMe, body: p.body ?? p.caption ?? '',\n  notifyName: d.notifyName ?? p.notifyName ?? null,\n  timestamp: p.timestamp ?? null,\n  mediaKind: mime.startsWith('audio/') || ['ptt','audio','voice'].includes(type) ? 'audio' : mime.startsWith('image/') || type === 'image' ? 'image' : p.hasMedia ? 'document' : 'text',\n} }];"
      },
